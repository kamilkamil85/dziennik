# Skopiuj ten plik jako .env i uzupełnij. Pliku .env NIE wrzucaj do gita ani nikomu nie wysyłaj.
# Nazwy LIBRUS*_LOGIN / LIBRUS*_HASLO są takie same jak w GitHub Secrets aplikacji mailowej.

LIBRUS1_LOGIN=
LIBRUS1_HASLO=
DZIECKO1_IMIE=Tadek
DZIECKO1_PIN=

LIBRUS2_LOGIN=
LIBRUS2_HASLO=
DZIECKO2_IMIE=Hela
DZIECKO2_PIN=

LIBRUS3_LOGIN=
LIBRUS3_HASLO=
DZIECKO3_IMIE=Jadzia
DZIECKO3_PIN=

# Wiadomości od tych osób są oznaczone jako "wychowawca" (fragment nazwiska, małe litery, po przecinku)
WAZNI_NADAWCY=nowak jan,kowalska anna

# Co ile minut najwyżej pobierać dane z Librusa (bądźmy dla Librusa łagodni)
CACHE_MINUTES=15

# 1 = pokaż przykładowe dane bez łączenia z Librusem (do testów wyglądu)
DEMO=0

# Ustaw 1, gdy aplikacja działa przez HTTPS (np. u Mariusza na domenie)
COOKIE_SECURE=0

# --- Tylko na serwerze (Docker). Wypełnij jedno, zależnie od wariantu ---
# Wariant Tailscale: klucz z https://login.tailscale.com/admin/settings/keys (Reusable: nie, Ephemeral: nie)
TS_AUTHKEY=
# Wariant Cloudflare Tunnel: token z Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
# Wariant własny reverse proxy: port na 127.0.0.1 (domyślnie 8000)
DZIENNIK_PORT=8000
